{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://contracts/p1008_t1_derived_kpi_bridge/v1.0/P1008_T1_VALIDATION_RECEIPT_V1.schema.json",
  "title": "P1008 T1 Validation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "validation_receipt_id", "source_candidate_id",
    "source_candidate_hash", "adapter_version", "adapter_hash", "created_at",
    "validation_status", "eligibility_gate", "recomputed_value",
    "governed_rounding_rule", "checks", "formal_authority", "actionable", "publication"
  ],
  "properties": {
    "schema_version": {"const": "P1008_T1_VALIDATION_RECEIPT_V1"},
    "validation_receipt_id": {"type": "string", "pattern": "^T1VR-[A-F0-9]{16}-[A-F0-9]{12}$"},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "adapter_version": {"const": "P1008_T1_DERIVED_KPI_ADAPTER_V1"},
    "adapter_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "validation_status": {"const": "PASS"},
    "eligibility_gate": {"const": "T1_EXACT_DERIVED_ONLY"},
    "recomputed_value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "governed_rounding_rule": {"type": "string", "pattern": "^DECIMAL_HALF_UP_[0-9]+DP$"},
    "checks": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "formal_authority": {"const": false},
    "actionable": {"const": false},
    "publication": {"const": false}
  }
}
