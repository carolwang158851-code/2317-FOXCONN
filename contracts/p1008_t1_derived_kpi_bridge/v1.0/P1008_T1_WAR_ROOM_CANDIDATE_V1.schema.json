{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://contracts/p1008_t1_derived_kpi_bridge/v1.0/P1008_T1_WAR_ROOM_CANDIDATE_V1.schema.json",
  "title": "P1008 T1 War Room Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "source_candidate_id", "synthetic_fixture", "metric_id", "dimension",
    "period", "as_of_date", "value", "unit", "data_tier", "formula_id",
    "formula_version", "formula_expression", "input_source_ids", "input_source_locators",
    "input_hashes", "source_candidate_hash", "adapter_version", "adapter_hash",
    "validation_receipt_id", "validation_receipt_hash", "created_at", "candidate_owner",
    "origin", "owner_review_required", "formal_authority", "actionable", "publication",
    "production_scoring_enabled"
  ],
  "properties": {
    "schema_version": {"const": "P1008_T1_WAR_ROOM_CANDIDATE_V1"},
    "candidate_id": {"type": "string", "pattern": "^WR-T1-[A-F0-9]{16}-[A-F0-9]{12}$"},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "synthetic_fixture": {"type": "boolean"},
    "metric_id": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["FUNDAMENTAL", "INDUSTRY_AI", "POSITIONING", "MACRO", "VALUATION"]},
    "period": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "unit": {"type": "string", "minLength": 1},
    "data_tier": {"const": "T1_EXACT_DERIVED"},
    "formula_id": {"type": "string", "minLength": 1},
    "formula_version": {"type": "string", "minLength": 1},
    "formula_expression": {"type": "string", "minLength": 1},
    "input_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_source_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-F0-9]{64}$"}},
    "source_candidate_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "adapter_version": {"const": "P1008_T1_DERIVED_KPI_ADAPTER_V1"},
    "adapter_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "validation_receipt_id": {"type": "string", "pattern": "^T1VR-[A-F0-9]{16}-[A-F0-9]{12}$"},
    "validation_receipt_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "candidate_owner": {"const": "WAR_ROOM"},
    "origin": {"const": "PLUGIN_DERIVED_T1"},
    "owner_review_required": {"const": true},
    "formal_authority": {"const": false},
    "actionable": {"const": false},
    "publication": {"const": false},
    "production_scoring_enabled": {"const": false}
  }
}
