{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://research-plugin/contracts/v2.0-draft/schemas/governance_ledger_record.schema.json",
  "title": "P1008 Research Governance Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "sequence",
    "record_contract_version",
    "recorded_at",
    "previous_hash",
    "record_hash",
    "event",
    "warroom_effective_change_applied",
    "actionable"
  ],
  "properties": {
    "ledger_id": {"const": "research_governance"},
    "sequence": {"type": "integer", "minimum": 1},
    "record_contract_version": {"const": "2.0-draft"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "event": {"$ref": "governance_event.schema.json"},
    "warroom_effective_change_applied": {"const": false},
    "actionable": {"const": false}
  }
}
