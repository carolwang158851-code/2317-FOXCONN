{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://research-plugin/contracts/v1.0/schemas/knowledge_gap.schema.json",
  "title": "P1008 Knowledge Gap",
  "type": "object",
  "additionalProperties": false,
  "required": ["gap_id", "gap_type", "statement", "severity", "blocks_claim_ids", "blocks_thesis_ids", "blocks_capabilities", "known_since", "resolution_requirements", "status", "owner_review_required", "no_precision_inference", "actionable"],
  "properties": {
    "gap_id": {"type": "string", "minLength": 1},
    "gap_type": {"enum": ["DATA", "SOURCE", "FRESHNESS", "EVIDENCE", "CAUSALITY", "CONFLICT", "CALIBRATION"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "normalized_statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "blocks_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocks_thesis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocks_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["financial", "deep_research", "macro", "foreign_flow", "valuation", "evidence", "report_candidate"]}},
    "known_since": {"type": "string", "format": "date-time"},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "resolution_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resolution_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["OPEN", "INVESTIGATING", "PARTIALLY_RESOLVED", "RESOLVED", "ACCEPTED_UNKNOWN", "RETIRED"]},
    "owner_review_required": {"type": "boolean"},
    "no_precision_inference": {"const": true},
    "actionable": {"const": false}
  }
}
