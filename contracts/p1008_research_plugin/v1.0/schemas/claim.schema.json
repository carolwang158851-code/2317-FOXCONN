{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://research-plugin/contracts/v1.0/schemas/claim.schema.json",
  "title": "P1008 Research Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim_text", "claim_type", "evidence_ids", "status", "confidence", "actionable"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "claim_text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claim_type": {"enum": ["OBSERVATION", "HYPOTHESIS", "MECHANISM", "INTERPRETATION", "COUNTER_CLAIM", "RESEARCH_STATUS"]},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counter_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocked_by_gap_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "CHALLENGED", "REFUTED", "CONFOUNDED", "INSUFFICIENT_DATA", "UNRESOLVED", "REJECTED"]},
    "confidence": {"enum": ["high", "medium", "low", "insufficient_data"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "actionable": {"const": false}
  }
}
