{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://report-governance/v1.0/event_evidence",
  "type": "object",
  "required": ["event_id", "event_type", "event_status", "occurred_at_utc", "published_at_utc", "received_at_utc", "data_cutoff", "source_id", "source_type", "source_class", "source_locator", "source_tier", "source_hash", "originating_chain_id", "evidence_ids", "claim_summary", "affected_kpis", "materiality", "novelty", "evidence_status", "validation_status", "confidence", "quality_metadata", "provenance", "canonical_event_id", "verification_status", "actionable"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1}, "event_type": {"type": "string", "minLength": 1}, "event_status": {"type": "string", "minLength": 1},
    "occurred_at_utc": {"type": "string", "format": "date-time"}, "published_at_utc": {"type": "string", "format": "date-time"}, "received_at_utc": {"type": "string", "format": "date-time"}, "data_cutoff": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1}, "source_type": {"enum": ["OFFICIAL_WEB", "AUTHORITY_DATASET", "COMPANY_FILING", "REGULATORY_FILING", "LOCAL_CANONICAL_ARTIFACT", "NEWS_MEDIA", "PLUGIN_EVIDENCE", "OTHER"]}, "source_class": {"enum": ["AUTHORITY", "SECONDARY", "DISCOVERY"]}, "source_locator": {"type": "string", "minLength": 1}, "source_url": {"type": "string"}, "source_tier": {"enum": ["CSV_AUTHORITY", "OFFICIAL", "PUBLIC_MARKET", "MEDIA", "OWNER_NOTE", "UNVERIFIED"]}, "source_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "originating_chain_id": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "claim_summary": {"type": "string", "minLength": 1}, "affected_kpis": {"type": "array"}, "materiality": {"type": "string", "minLength": 1}, "novelty": {"type": "string", "minLength": 1}, "evidence_status": {"enum": ["DISCOVERED", "CORROBORATED", "CONFIRMED"]}, "validation_status": {"enum": ["VERIFIED", "OFFICIAL_VERIFIED", "VALIDATED"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "quality_metadata": {"type": "object"}, "provenance": {"type": "object"}, "canonical_event_id": {"type": "string", "minLength": 1}, "verification_status": {"enum": ["VERIFIED", "OFFICIAL_VERIFIED", "VALIDATED"]}, "counter_evidence_ids": {"type": "array"}, "missing_evidence": {"type": "array"}, "source_conflicts": {"type": "array"}, "actionable": {"const": false}
  }, "additionalProperties": false
}
