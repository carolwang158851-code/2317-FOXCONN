{
  "policyId": "P1008_EXTERNAL_DISCOVERY_PROVIDER_MINIMUM_GOVERNANCE",
  "policyVersion": "1.0",
  "status": "PENDING_OWNER_ACCEPTANCE",
  "providerNeutral": true,
  "actionable": false,
  "identityGovernance": {
    "requiredFields": [
      "provider_id",
      "vendor",
      "distribution_source",
      "release_version",
      "immutable_source_revision",
      "artifact_sha256",
      "acquired_at_utc",
      "allowed_endpoint_identities"
    ],
    "mutableTagIsAuthority": false,
    "shadowIdentityMayReplaceGovernedIdentity": false,
    "identityMismatchOutcome": "FAIL_CLOSED"
  },
  "repinGovernance": {
    "explicitOwnerAuthorizationRequired": true,
    "impactAnalysisRequired": true,
    "migrationPlanRequired": true,
    "rollbackPlanRequired": true,
    "validationAndRegressionEvidenceRequired": true,
    "successfulShadowValidationMayOverrideGovernedPin": false,
    "automaticRollbackProhibited": true
  },
  "credentialGovernance": {
    "allowedModes": [
      "CREDENTIALS_REQUIRED",
      "CREDENTIALS_OPTIONAL",
      "ANONYMOUS_ONLY"
    ],
    "modeBoundToGovernedIdentityPolicy": true,
    "credentialsRequiredOutcomes": {
      "missingSecret": "FAIL_CLOSED",
      "invalidSecret": "FAIL_CLOSED",
      "secretLoadFailure": "FAIL_CLOSED",
      "anonymousDowngrade": "PROHIBITED"
    },
    "credentialsOptionalAnonymousExecutionRequiresExplicitOwnerAuthorization": true,
    "credentialsOptionalSilentDowngradeProhibited": true,
    "anonymousOnlySecretLoadingProhibited": true,
    "secretPersistenceProhibited": true,
    "secretLoggingProhibited": true,
    "secretInEvidenceArtifactsProhibited": true,
    "automaticRegistrationOrRotationProhibited": true
  },
  "runtimeGovernance": {
    "networkDefault": "DENY",
    "missingRequiredRuntimeOutcome": "FAIL_CLOSED",
    "unavailableRequiredCapabilityOutcome": "FAIL_CLOSED",
    "unexpectedEndpointOutcome": "FAIL_CLOSED",
    "unauthorizedCapabilityOutcome": "FAIL_CLOSED",
    "providerFailureOutcome": "FAIL_CLOSED",
    "automaticRetryProhibited": true,
    "fallbackProhibitedUnlessSeparatelyAuthorized": true
  },
  "promotionGovernance": {
    "requiredEvidenceDimensions": [
      "coverage",
      "precision",
      "source_quality",
      "duplication_noise",
      "validation_behavior",
      "failure_behavior",
      "output_provenance"
    ],
    "allEvidenceDimensionsRequired": true,
    "connectivitySuccessSufficient": false,
    "searchOrRetrievalSuccessSufficient": false,
    "explicitOwnerAuthorizationRequired": true
  },
  "authorityBoundary": {
    "providerOutputClass": "DISCOVERY",
    "authorityPromotionInsideAdapterProhibited": true,
    "authorityWriteProhibited": true,
    "productionEvidenceLedgerWriteProhibited": true,
    "coreViewWriteProhibited": true,
    "formalReportGenerationOrPublicationProhibited": true,
    "retrievalSuccessMayBecomeActionable": false
  }
}
