{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P1008_KPI_SUPPLEMENT_RECORD_V1.schema.json",
  "title": "P1008 KPI Supplement Record V1",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_hash",
    "metric_id",
    "semantic_name",
    "period",
    "as_of_date",
    "source_effective_date",
    "value",
    "unit",
    "data_tier",
    "formula_id",
    "formula_version",
    "source_ids",
    "source_hashes",
    "confidence",
    "assumptions",
    "limitations",
    "status",
    "validation_status",
    "created_at",
    "source_candidate",
    "formal_authority",
    "formal_scoring_eligible",
    "actionable"
  ],
  "properties": {
    "schema_version": {
      "const": "P1008_KPI_SUPPLEMENT_RECORD_V1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_name": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "source_effective_date": {
      "type": "string",
      "format": "date"
    },
    "value": {
      "type": [
        "string",
        "number"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "data_tier": {
      "enum": [
        "T1_EXACT_DERIVED",
        "T2_ESTIMATED_DERIVED"
      ]
    },
    "formula_id": {
      "type": "string",
      "minLength": 1
    },
    "formula_version": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-F0-9]{64}$"
      }
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "assumptions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "range": {
      "type": [
        "object",
        "null"
      ]
    },
    "owner_approval_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "const": "ACTIVE"
    },
    "validation_status": {
      "const": "PASS"
    },
    "created_at": {
      "type": "string"
    },
    "source_candidate": {
      "type": "object"
    },
    "owner_approval": {
      "type": [
        "object",
        "null"
      ]
    },
    "formal_authority": {
      "const": false
    },
    "formal_scoring_eligible": {
      "const": false
    },
    "actionable": {
      "const": false
    }
  },
  "additionalProperties": true
}
