{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P1008_T2_ANNOTATED_DISPLAY_V1.schema.json",
  "title": "P1008 T2 annotated research display",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "display_state", "candidate_id", "candidate_hash", "approval_id", "metric_id",
    "metric_name", "period", "use_scope", "display_label_zh", "display_text_zh", "point_estimate",
    "estimate_lower_bound", "estimate_upper_bound", "unit", "confidence", "confidence_label_zh",
    "basis_assumptions_summary_zh", "not_directly_disclosed", "disclosure_zh", "data_tier",
    "owner_approved_for_annotated_use", "formal_authority", "formal_scoring_eligible",
    "formal_publish_eligible", "research_only", "actionable"
  ],
  "properties": {
    "schema_version": {"const": "P1008_T2_ANNOTATED_DISPLAY_V1"},
    "display_state": {"const": "ANNOTATED_RESEARCH_KPI"},
    "candidate_id": {"type": "string"},
    "candidate_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "approval_id": {"type": "string"},
    "metric_id": {"type": "string"},
    "metric_name": {"type": "string"},
    "period": {"type": "string"},
    "use_scope": {"enum": ["REPORT_MAIN_TEXT", "REPORT_KPI_TABLE", "RESEARCH_APPENDIX"]},
    "display_label_zh": {"const": "推估值"},
    "display_text_zh": {"type": "string", "allOf": [{"pattern": "推估"}, {"pattern": "非公司直接揭露"}, {"pattern": "信心"}, {"pattern": "基礎/假設"}]},
    "point_estimate": {"type": "string"},
    "estimate_lower_bound": {"type": "string"},
    "estimate_upper_bound": {"type": "string"},
    "unit": {"type": "string"},
    "confidence": {"enum": ["MEDIUM", "LOW"]},
    "confidence_label_zh": {"enum": ["中", "低"]},
    "basis_assumptions_summary_zh": {"type": "string", "minLength": 1},
    "not_directly_disclosed": {"const": true},
    "disclosure_zh": {"const": "非公司直接揭露"},
    "data_tier": {"const": "T2_ESTIMATED_DERIVED"},
    "owner_approved_for_annotated_use": {"const": true},
    "formal_authority": {"const": false},
    "formal_scoring_eligible": {"const": false},
    "formal_publish_eligible": {"const": false},
    "research_only": {"const": true},
    "actionable": {"const": false}
  }
}
