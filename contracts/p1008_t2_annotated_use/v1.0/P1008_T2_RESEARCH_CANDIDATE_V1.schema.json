{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P1008_T2_RESEARCH_CANDIDATE_V1.schema.json",
  "title": "P1008 T2 research candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "source_candidate_id", "source_candidate_hash",
    "synthetic_fixture", "metric_id", "metric_name", "dimension", "period", "as_of_date",
    "point_estimate", "unit", "data_tier", "formula_id", "formula_version",
    "formula_expression", "input_metric_ids", "input_values", "input_units", "input_periods",
    "input_source_ids", "input_source_tiers", "input_source_locators", "input_hashes",
    "assumptions", "rounding_rule", "estimation_method", "confidence", "limitations",
    "estimate_lower_bound", "estimate_upper_bound", "range_method", "sensitivity_notes",
    "semantic_name", "semantic_match_status", "period_basis", "unit_basis",
    "denominator_definition", "reconciliation_state", "adapter_version", "adapter_hash",
    "created_at", "candidate_owner", "origin", "display_label_zh", "directly_disclosed",
    "claims_official", "owner_review_required", "owner_approved_for_annotated_use",
    "formal_authority", "formal_scoring_eligible", "formal_publish_eligible",
    "production_scoring_enabled", "research_only", "actionable"
  ],
  "properties": {
    "schema_version": {"const": "P1008_T2_RESEARCH_CANDIDATE_V1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "synthetic_fixture": {"type": "boolean"},
    "metric_id": {"type": "string", "minLength": 1},
    "metric_name": {"type": "string", "minLength": 1},
    "dimension": {"type": "string", "minLength": 1},
    "period": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "minLength": 1},
    "point_estimate": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "unit": {"type": "string", "minLength": 1},
    "data_tier": {"const": "T2_ESTIMATED_DERIVED"},
    "formula_id": {"type": "string", "minLength": 1},
    "formula_version": {"type": "string", "minLength": 1},
    "formula_expression": {"type": "string", "minLength": 1},
    "input_metric_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_values": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_units": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_periods": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_source_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_source_tiers": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_source_locators": {"$ref": "#/$defs/nonEmptyStringArray"},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-F0-9]{64}$"}},
    "assumptions": {"$ref": "#/$defs/nonEmptyStringArray"},
    "rounding_rule": {"type": "string", "minLength": 1},
    "estimation_method": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["MEDIUM", "LOW"]},
    "limitations": {"$ref": "#/$defs/nonEmptyStringArray"},
    "estimate_lower_bound": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "estimate_upper_bound": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "range_method": {"type": "string", "minLength": 1},
    "sensitivity_notes": {"type": "string", "minLength": 1},
    "semantic_name": {"type": "string", "minLength": 1},
    "semantic_match_status": {"const": "EXACT_MATCH"},
    "period_basis": {"type": "string", "minLength": 1},
    "unit_basis": {"type": "string", "minLength": 1},
    "denominator_definition": {"type": "string", "minLength": 1},
    "reconciliation_state": {"const": "ESTIMATE_ACTIVE"},
    "adapter_version": {"const": "P1008_T2_ANNOTATED_USE_ADAPTER_V1"},
    "adapter_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "candidate_owner": {"const": "WAR_ROOM_RESEARCH"},
    "origin": {"const": "PLUGIN_DERIVED_T2"},
    "display_label_zh": {"const": "推估值"},
    "directly_disclosed": {"const": false},
    "claims_official": {"const": false},
    "owner_review_required": {"const": true},
    "owner_approved_for_annotated_use": {"const": false},
    "formal_authority": {"const": false},
    "formal_scoring_eligible": {"const": false},
    "formal_publish_eligible": {"const": false},
    "production_scoring_enabled": {"const": false},
    "research_only": {"const": true},
    "actionable": {"const": false}
  },
  "$defs": {
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
