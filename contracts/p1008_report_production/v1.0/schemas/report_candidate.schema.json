{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://report/v1.0/report_candidate",
  "type": "object",
  "required": ["recordType", "runId", "eventType", "generatedAtUtc", "reportContractVersion", "analysisPacketSha256", "authorityManifestSha256", "primaryInvestorQuestion", "thesisState", "evidenceBoundFacts", "evidenceReferences", "sections", "actionable"],
  "properties": {
    "recordType": {"const": "P1008_REPORT_CANDIDATE"}, "runId": {"type": "string", "minLength": 1},
    "eventType": {"const": "MONTHLY_REVENUE"}, "generatedAtUtc": {"type": "string", "format": "date-time"},
    "reportContractVersion": {"const": "1.0"}, "analysisPacketSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "authorityManifestSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "primaryInvestorQuestion": {"type": "string", "minLength": 1},
    "thesisState": {"enum": ["IMPROVING", "MAINTAINED", "REVIEW_REQUIRED"]},
    "evidenceBoundFacts": {"type": "array", "minItems": 1},
    "evidenceReferences": {"type": "array", "minItems": 1, "items": {"$ref": "evidence_reference.schema.json"}},
    "sections": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["sectionId", "titleZh", "bodyZh", "epistemicClass", "evidenceIds"],
        "properties": {
          "sectionId": {"type": "string", "minLength": 1},
          "titleZh": {"type": "string", "minLength": 1},
          "bodyZh": {"type": "string", "minLength": 1},
          "epistemicClass": {"enum": ["FACT", "INFERENCE", "MIXED", "COMPLIANCE"]},
          "evidenceIds": {"type": "array"}
        },
        "additionalProperties": false
      }
    },
    "actionable": {"const": false}
  },
  "additionalProperties": false
}
