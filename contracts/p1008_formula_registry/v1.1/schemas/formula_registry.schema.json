{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://formula-registry/v1.1/formula_registry",
  "type": "object",
  "required": [
    "formulaRegistryId", "registryVersion", "status", "predecessor",
    "lifecycleClassifications", "entries", "actionable", "formalDecision",
    "holdChangeAllowed", "ruleChangeAllowed", "productionActivation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "formulaRegistryId": {"const": "P1008_FORMULA_REGISTRY"},
    "registryVersion": {"const": "1.1"},
    "status": {"const": "OWNER_AUTHORIZED_RTM0_PRODUCTION_ACTIVATION"},
    "predecessor": {
      "type": "object",
      "required": ["version", "rootHash", "commitSha"],
      "properties": {
        "version": {"const": "1.0"},
        "rootHash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "lifecycleClassifications": {
      "const": ["CURRENT_PRODUCTION", "OWNER_APPROVED_CANDIDATE", "RESEARCH_ONLY", "REJECTED", "LEGACY"]
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["formulaId", "lifecycleClassification", "formulaDefinition", "dataProvenance", "activationStatus", "ownerApproval", "backtestEvidence", "implementationStatus"]
      }
    },
    "actionable": {"const": false},
    "formalDecision": {"const": false},
    "holdChangeAllowed": {"const": false},
    "ruleChangeAllowed": {"const": false},
    "productionActivation": {"const": true}
  },
  "additionalProperties": false
}
