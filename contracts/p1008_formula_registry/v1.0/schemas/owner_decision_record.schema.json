{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1008://formula-registry/v1.0/owner_decision_record",
  "type": "object",
  "required": [
    "recordType",
    "recordVersion",
    "decisionId",
    "decisionDate",
    "approvalReference",
    "decisions",
    "backtestEvidence",
    "authorityProtection",
    "buildEvidence",
    "implementationCommitSha",
    "commitStatus",
    "activationReceipt",
    "actionable",
    "formalDecision",
    "holdChanged",
    "ruleChanged",
    "productionActivation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "recordType": {"const": "P1008_FORMULA_REGISTRY_OWNER_DECISION"},
    "recordVersion": {"const": "1.0"},
    "decisionId": {"type": "string", "minLength": 1},
    "decisionDate": {"type": "string", "format": "date"},
    "approvalReference": {"type": "string", "minLength": 1},
    "decisions": {"type": "object"},
    "backtestEvidence": {"type": "object"},
    "authorityProtection": {"type": "object"},
    "buildEvidence": {"type": "object"},
    "implementationCommitSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "commitStatus": {"const": "NOT_COMMITTED"},
    "activationReceipt": {"const": false},
    "actionable": {"const": false},
    "formalDecision": {"const": false},
    "holdChanged": {"const": false},
    "ruleChanged": {"const": false},
    "productionActivation": {"const": false}
  },
  "additionalProperties": false
}
