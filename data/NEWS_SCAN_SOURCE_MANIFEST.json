  "defaultQueryMatrix": [
    "鴻海",
    "2317",
    "Hon Hai",
    "Foxconn",
    "富士康",
    "鴻海 AI server",
    "Foxconn NVIDIA GB200",
    "鴻海 匯率",
    "鴻海 出口管制"
  ],
  "sourceTierPolicy": {
    "allowedSourceTiers": [
      "OFFICIAL",
      "PUBLIC_MARKET",
      "MEDIA",
      "OWNER_NOTE",
      "UNVERIFIED"
    ],
    "singleMediaMaxLevel": "WATCH",
    "unverifiedMaxLevel": "OBSERVE",
    "reviewRequiredRule": "OFFICIAL direct event, or two-plus independent media/public-market sources plus explicit Hon Hai relevance, CSP capex/AI data center demand, GB200/GB300/AI server linkage, supply-chain disruption, macro/FX/rate stress, tariff/export-control/sanction, or other direct market-impact trigger.",
    "connectorPolicy": "Only enabled=true and connectorStatus=APPROVED sources may be fetched. All fetched rows remain observation-only and Actionable=false."
  },
  "scanWindowsTST": [
    {
      "id": "preopen",
      "time": "08:10",
      "lookbackHours": 16,
      "purpose": "Pre-open protection"
    },
    {
      "id": "intraday",
      "time": "12:30",
      "lookbackHours": 6,
      "purpose": "Intraday event check"
    },
    {
      "id": "postclose",
      "time": "15:30",
      "lookbackHours": 8,
      "purpose": "Post-close event check"
    },
    {
      "id": "global",
      "time": "21:30",
      "lookbackHours": 12,
      "purpose": "International, Fed, FX, oil, and geopolitics check"
    },
    {
      "id": "report",
      "time": "WEEKEND_OR_MONDAY",
      "lookbackHours": 168,
      "purpose": "Weekly report counter-evidence audit"
    }
